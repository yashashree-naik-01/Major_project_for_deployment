# Copy this file to .env.local and replace the example values.
GRAPHHOPPER_API_KEY=replace_with_your_graphhopper_key
GEOAPIFY_API_KEY=replace_with_your_geoapify_key
NOMINATIM_CONTACT=mailto:you@example.com
# Geoapify is preferred when its key is set. Otherwise the local prototype uses
# Nominatim/Photon for search and Valhalla/pedestrian OSRM for routes.
# GEOAPIFY_GEOCODE_URL=https://api.geoapify.com/v1/geocode/search
# GEOAPIFY_ROUTE_URL=https://api.geoapify.com/v1/routing
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# PHOTON_URL=https://photon.komoot.io/api/
# VALHALLA_URL=https://valhalla1.openstreetmap.de/route
# OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot/route/v1/driving
# PROVIDER_TIMEOUT_MS=15000
# GEOCODE_RATE_LIMIT_PER_MINUTE=60
# ROUTE_RATE_LIMIT_PER_MINUTE=60

# Browser authentication (never use a Supabase secret/service_role key here)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Real emergency SMS (server-side only). Configure either option below.
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=MG_replace_me

# For deployment or testing on another device:
# HOST=0.0.0.0
# PORT=4173
